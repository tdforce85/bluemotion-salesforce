<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <masterLabel>BMC Site Header</masterLabel>
    <description
  >Sticky site header with text logo, primary navigation, and external link. LWR-only, mobile-responsive with hamburger menu.</description>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="homeUrl"
        type="String"
        label="Home URL (Logo Link)"
        default="/"
      />
            <property
        name="overEngineeredLeadFormUrl"
        type="String"
        label="Over Engineered Lead Form URL"
        default="/"
      />
            <property
        name="errorHandlingDashboardUrl"
        type="String"
        label="Error Handling Dashboard URL"
        default="/"
      />
            <property
        name="externalLinkUrl"
        type="String"
        label="External Link URL"
        default="https://tonydegregorio.com"
      />
            <property
        name="externalLinkLabel"
        type="String"
        label="External Link Label"
        default="tonydegregorio.com"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
